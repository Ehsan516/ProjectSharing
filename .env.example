# Supabase -> Project Settings -> API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key, or the newer "publishable" key (sb_publishable_...) — both work
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: public URL of the site, used for magic-link redirects in production
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Server-only (never prefix with NEXT_PUBLIC_). Used by /api/cron/cleanup to delete orphaned uploads.
SUPABASE_SECRET_KEY=sb_secret_...
CRON_SECRET=any-long-random-string
